# Copy this file to .env and fill in the values.
# Never commit .env (it's already in .gitignore).

# Neon Postgres (the waitlist database).
# In Neon: your project → Connect → copy the connection string.
DATABASE_URL=

# Password for downloading the waitlist at /api/admin/waitlist.
# Use at least 12 characters. Leave empty to turn the download off.
ADMIN_PASSWORD=

# Upstash Redis (rate limiting for the free checker and waitlist).
# Optional for local development: without these, an in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
